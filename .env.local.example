# Copy this file to .env.local and fill in values from your Supabase project:
# Dashboard → Project Settings → API
#
# Use either:
#   - Legacy tab → "anon" "public" key (starts with eyJ...), or
#   - API Keys tab → Publishable key (starts with sb_publishable_...)
#
# The URL and key must come from the SAME project.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
